# =================================================================
# Environment Configuration Template (Copy this to .env to deploy)
# =================================================================

# 1. PostgreSQL Database Configuration
POSTGRES_DB=qlbm_db
POSTGRES_USER=qlbm_user
POSTGRES_PASSWORD=qlbm_password

# External DB port on the host machine
POSTGRES_PORT_HOST=5433

# 2. Django Backend Configuration
# Use a secure, unique key for production deployment
DJANGO_SECRET_KEY=django-insecure-prod-must-be-changed-in-production-123456

# Disable debug in production for security and performance
DJANGO_DEBUG=False

# Django ALLOWED_HOSTS comma-separated list (e.g. localhost,127.0.0.1)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Combined Database URL for Django DB connection
DATABASE_URL=postgres://qlbm_user:qlbm_password@db:5432/qlbm_db

# 3. Nginx Web Configuration
# External HTTP Port for client access
NGINX_PORT_HOST=8090
